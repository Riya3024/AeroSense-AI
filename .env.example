# Copy to .env (Copy-Item .env.example .env) and fill in. .env is git-ignored.

# --- OpenAQ (REQUIRED) -------------------------------------------------------
# Free key: register at https://explore.openaq.org/register, then see
# https://explore.openaq.org/account
OPENAQ_API_KEY=

# --- Stations ----------------------------------------------------------------
# Option A (default): discover PM2.5 stations inside this bounding box
# (min_lon,min_lat,max_lon,max_lat, WGS84). Approximate extent of Delhi NCT;
# it may include a few border stations of neighbouring cities. Tune as needed.
DELHI_BBOX=76.84,28.40,77.35,28.88
# Option B: pin explicit OpenAQ *location* IDs (comma separated). Overrides bbox.
# Run `python -m data_pipeline.fetch_openaq --list-stations` to see candidates.
OPENAQ_LOCATION_IDS=

# --- Date range (UTC, inclusive) ---------------------------------------------
START_DATE=2025-01-01
END_DATE=2026-09-30

# --- OpenAQ request settings -------------------------------------------------
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_PAGE_LIMIT=1000
OPENAQ_CHUNK_DAYS=30
# Free tier = 60 req/min and 2000 req/hour; 1.1 s keeps you under 60/min.
OPENAQ_MIN_REQUEST_INTERVAL_S=1.1
REQUEST_TIMEOUT_S=30
MAX_RETRIES=5
BACKOFF_S=2.0

# --- Weather (Open-Meteo Historical API, no key) -------------------------------
WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive
# Leave blank => one request per station coordinate.
# Set both => use a single point for every station.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_VARIABLES=temperature_2m,relative_humidity_2m,dew_point_2m,surface_pressure,precipitation,wind_speed_10m,wind_direction_10m,wind_gusts_10m,cloud_cover,shortwave_radiation

# --- Cleaning ----------------------------------------------------------------
# PM2.5 above this (ug/m3) is treated as a sensor artefact -> missing.
PM25_MAX_PLAUSIBLE=2000
# Max consecutive missing weather hours that may be forward-filled.
WEATHER_MAX_GAP_HOURS=3

# =============================================================================
# AeroSense application + AWS (all optional until you deploy; nothing here is a secret)
# =============================================================================
# NEVER put AWS access keys in this file or in any project file. Locally, authenticate with
#   aws configure   (or: aws sso login)   and optionally set AWS_PROFILE below.
# Inside Lambda / SageMaker the attached IAM role supplies credentials automatically.
AEROSENSE_ENV=local
AWS_REGION=ap-south-1
# AWS_PROFILE=default

# Single project bucket (created by aws\scripts\create-s3-bucket.ps1). Prefixes: raw/ processed/ models/
AEROSENSE_S3_BUCKET=
# ARN of the SageMaker execution role (Phase 2). Leave blank until created.
SAGEMAKER_ROLE_ARN=
# Name of the deployed SageMaker inference endpoint (Phase 2/3). Leave blank until it exists.
SAGEMAKER_ENDPOINT_NAME=
# Optional: only set if DynamoDB is actually adopted (not required for the MVP).
DYNAMODB_TABLE_NAME=
CLOUDWATCH_LOG_RETENTION_DAYS=14
# CORS origin the API allows. Use your Amplify domain once the frontend is deployed.
API_ALLOWED_ORIGIN=http://localhost:3000

# =============================================================================
# Phase 2: location, pollutants, request budget (no secrets here)
# =============================================================================
# Representative point for the study area (New Delhi city centre, approximate). Used for reporting and, when
# WEATHER_MODE=location, as the single weather point. Station discovery still uses DELHI_BBOX above.
# For wider NCR coverage, set a larger DELHI_BBOX (min_lon,min_lat,max_lon,max_lat).
LOCATION_NAME=Delhi
LOCATION_LATITUDE=28.6139
LOCATION_LONGITUDE=77.2090
# station = one Open-Meteo point per station (default); location = one point at LOCATION_* for all stations
WEATHER_MODE=station
# Pollutants to fetch from OpenAQ. pm25 is required (it defines the target). Fewer pollutants = far fewer requests.
POLLUTANTS=pm25,pm10,no2,o3,co,so2
# Expected unit per pollutant (default ug/m3). Rows in any other unit are DROPPED AND COUNTED, never converted.
# Example if your CO sensors report mg/m3:  POLLUTANT_UNITS=co=mg/m3
POLLUTANT_UNITS=
# Stay below OpenAQ's free-tier limit of 2000 requests/hour.
OPENAQ_MAX_REQUESTS_PER_HOUR=1800
# Root folder inside the S3 bucket.
AEROSENSE_S3_PREFIX=aerosense
